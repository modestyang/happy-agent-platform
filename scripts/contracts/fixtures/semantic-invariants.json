{
  "public": {
    "anyOfRequiredChoices": {
      "CreateBodyMetricRecordRequest": ["weightKg", "bodyFatPercent", "waistCm", "restingHeartRateBpm"]
    },
    "discriminatedUnions": {
      "DailyMealPlan": {"property":"status", "values":["GENERATING", "READY", "FAILED"]},
      "CreateMealRecordRequest": {"property":"source", "values":["MANUAL", "RECOGNITION_CONFIRMED"]},
      "CurrentGoalReport": {"property":"state", "values":["QUEUED", "GENERATING", "READY", "STALE", "FAILED"]},
      "AgentRunEvent": {"property":"type", "values":["RUN_STATE", "TEXT_DELTA", "STRUCTURED_COMPONENT", "TOOL", "APPROVAL", "ERROR", "COMPLETED"]}
    },
    "unionBranches": {
      "CurrentGoalReport": {
        "property":"state",
        "branches": {
          "QUEUED":{"required":["reportId","goalId","goalVersion","state","windowStart","windowEnd","updatedAt"],"forbidden":["metrics","computedThrough","failure"]},
          "GENERATING":{"required":["reportId","goalId","goalVersion","state","windowStart","windowEnd","updatedAt"],"forbidden":["metrics","computedThrough","failure"]},
          "READY":{"required":["reportId","goalId","goalVersion","state","windowStart","windowEnd","metrics","computedThrough","updatedAt"],"forbidden":["failure"]},
          "STALE":{"required":["reportId","goalId","goalVersion","state","windowStart","windowEnd","metrics","computedThrough","updatedAt"],"forbidden":["failure"]},
          "FAILED":{"required":["reportId","goalId","goalVersion","state","windowStart","windowEnd","failure","updatedAt"],"forbidden":["metrics","computedThrough"]}
        }
      }
    },
    "requiredProperties": {
      "ReadyDailyMealPlan": ["breakfast", "lunch", "dinner", "dailyNutrition"]
    },
    "propertyPatterns": {
      "OtherMealRecommendationFeedbackRequest.note": "\\S"
    }
  },
  "admin": {
    "discriminatedUnions": {
      "ClosedJsonSchema": {"property":"type", "values":["OBJECT", "ARRAY", "STRING", "NUMBER", "INTEGER", "BOOLEAN"]},
      "AgentRunEvent": {"property":"type", "values":["RUN_STATE", "TEXT_DELTA", "STRUCTURED_OUTPUT", "TOOL", "HOOK", "APPROVAL", "CHECKPOINT", "ERROR", "COMPLETED"]},
      "ProbeJob": {"property":"status", "values":["QUEUED", "RUNNING", "SUCCEEDED", "FAILED"]}
    },
    "requiredProperties": {
      "AgentVersion": ["frameworkVersion","providerVersion","modelBinding","promptVersion","toolBindings","skillBindings","hookBindings","memoryPolicyVersion","outputSchemaVersion","evaluationSuiteVersion","defaultProfileVersion","resolvedEffectiveConfig"],
      "ResolvedAgentConfig": ["modelParameters"],
      "AgentDraftPatchRequest": ["resetPaths"],
      "SkillPatchRequest": ["status"],
      "ObjectJsonSchema": ["properties"],
      "PublishedComponentRef": ["componentKey","version","componentChecksum"],
      "PublishedToolBinding": ["toolKey","contractVersion","enabled","componentChecksum"],
      "PublishedSkillBinding": ["skillKey","version","enabled","componentChecksum"],
      "PublishedHookBinding": ["hookKey","version","enabled","componentChecksum"],
      "EffectiveValueSource": ["source"],
      "PublishedResolvedConfig": ["applicationScope","runtimeLimits","modelParameters","retryPolicy","sources"],
      "PublishedResolvedConfigSources": ["runtimeMaxRunSeconds","runtimeMaxToolCalls","runtimeMaxInputTokens","runtimeMaxOutputTokens","runtimeMaxCostUsd","runtimeConcurrentRuns","modelTemperature","modelTopP","modelMaxOutputTokens","retryPolicy","memoryPolicy","outputSchema","defaultProfile"]
    },
    "arrayMinimums": {
      "ObjectJsonSchema.properties": 1
    },
    "uniqueArrays": ["AgentVersion.toolBindings","AgentVersion.skillBindings","AgentVersion.hookBindings"],
    "uniqueArraysBy": {
      "AgentVersion.toolBindings":["toolKey","contractVersion"],
      "AgentVersion.skillBindings":["skillKey","version"],
      "AgentVersion.hookBindings":["hookKey","version"]
    },
    "arraysAllowEmpty": ["AgentVersion.toolBindings","AgentVersion.skillBindings","AgentVersion.hookBindings"],
    "forbiddenProperties": {"AgentVersion":["runtimeLimits","modelParameters","componentChecksums"]},
    "forbiddenSchemas": ["PublishedComponentChecksums"],
    "minimumProperties": {"SparseModelParameters":1},
    "schemaPropertyRefs": {
      "DefaultValues.modelParameters":"SparseModelParameters",
      "ResolvedAgentConfig.modelParameters":"ModelParameters",
      "AgentVersion.frameworkVersion":"PublishedComponentRef",
      "AgentVersion.providerVersion":"PublishedComponentRef",
      "AgentVersion.modelBinding":"PublishedComponentRef",
      "AgentVersion.promptVersion":"PublishedComponentRef",
      "AgentVersion.memoryPolicyVersion":"PublishedComponentRef",
      "AgentVersion.outputSchemaVersion":"PublishedComponentRef",
      "AgentVersion.evaluationSuiteVersion":"PublishedComponentRef",
      "AgentVersion.defaultProfileVersion":"PublishedComponentRef",
      "AgentVersion.resolvedEffectiveConfig":"PublishedResolvedConfig",
      "PublishedResolvedConfig.runtimeLimits":"RuntimeLimits",
      "PublishedResolvedConfig.modelParameters":"ModelParameters",
      "PublishedResolvedConfig.retryPolicy":"RetryPolicy",
      "PublishedResolvedConfig.sources":"PublishedResolvedConfigSources",
      "PublishedResolvedConfigSources.runtimeMaxRunSeconds":"EffectiveValueSource",
      "PublishedResolvedConfigSources.runtimeMaxToolCalls":"EffectiveValueSource",
      "PublishedResolvedConfigSources.runtimeMaxInputTokens":"EffectiveValueSource",
      "PublishedResolvedConfigSources.runtimeMaxOutputTokens":"EffectiveValueSource",
      "PublishedResolvedConfigSources.runtimeMaxCostUsd":"EffectiveValueSource",
      "PublishedResolvedConfigSources.runtimeConcurrentRuns":"EffectiveValueSource",
      "PublishedResolvedConfigSources.modelTemperature":"EffectiveValueSource",
      "PublishedResolvedConfigSources.modelTopP":"EffectiveValueSource",
      "PublishedResolvedConfigSources.modelMaxOutputTokens":"EffectiveValueSource",
      "PublishedResolvedConfigSources.retryPolicy":"EffectiveValueSource",
      "PublishedResolvedConfigSources.memoryPolicy":"EffectiveValueSource",
      "PublishedResolvedConfigSources.outputSchema":"EffectiveValueSource",
      "PublishedResolvedConfigSources.defaultProfile":"EffectiveValueSource"
    },
    "arrayItemRefs": {
      "AgentVersion.toolBindings":"PublishedToolBinding",
      "AgentVersion.skillBindings":"PublishedSkillBinding",
      "AgentVersion.hookBindings":"PublishedHookBinding"
    },
    "propertyPatterns": {
      "PublishedComponentRef.componentChecksum":"^[a-f0-9]{64}$",
      "PublishedToolBinding.componentChecksum":"^[a-f0-9]{64}$",
      "PublishedSkillBinding.componentChecksum":"^[a-f0-9]{64}$",
      "PublishedHookBinding.componentChecksum":"^[a-f0-9]{64}$"
    },
    "arrayEnumIncludes": {
      "AgentDraftPatchRequest.resetPaths":["runtime.modelParameters.temperature","runtime.modelParameters.topP","runtime.modelParameters.maxOutputTokens"]
    },
    "arrayEnumExcludes": {
      "AgentDraftPatchRequest.resetPaths":["runtime.modelParameters"]
    }
  }
}
